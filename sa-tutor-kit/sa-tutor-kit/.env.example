# Copy this file to ".env" (same folder) and fill it in. Never share or upload your .env.
# --- teacher model: writes training data, extracts questions, analyses failures ---
TEACHER_BASE_URL=https://api.deepseek.com
TEACHER_API_KEY=
TEACHER_MODEL=deepseek-chat
TEACHER_PRICE_IN=0.15
TEACHER_PRICE_OUT=0.60
TEACHER_JSON_MODE=1
# --- judge model (optional). A different model family grades more fairly than the one that wrote the data.
# If you leave these out, the judge is the teacher.
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_MODEL=
JUDGE_PRICE_IN=
JUDGE_PRICE_OUT=
# --- safety: every API call is logged; calls STOP when the total reaches this many US dollars ---
MAX_SPEND_USD=15
# --- where your data lives (default: ./workspace) ---
# SA_WORKSPACE=/content/drive/MyDrive/sa-tutor/workspace
