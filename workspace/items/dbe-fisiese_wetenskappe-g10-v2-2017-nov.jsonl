{"item_id": "dbe-fisiese_wetenskappe-g10-v2-2017-nov-6.2.1", "source_id": "dbe-fisiese_wetenskappe-g10-v2-2017-nov", "pair_source_id": "dbe-fisiese_wetenskappe-g10-v2-2017-nov-memo", "subject": "fisiese_wetenskappe", "grade": 12, "language": "af", "track": "sciences", "kind": "question", "question_ref": "6.2.1", "marks": 2, "topic": "Molêre massa", "passage": "", "question": "Bereken die molêre massa van natriumkarbonaat ($\\text{Na}_2\\text{CO}_3$).", "memo": "$M(\\text{Na}_2\\text{CO}_3) = 2(23) + 12 + 3(16) \\checkmark = 106 \\text{ g}\\cdot\\text{mol}^{-1} \\checkmark$", "final_answer": "106 g/mol", "needs_review": false, "licence": "DBE copyright - check terms", "attribution": "Department of Basic Education"}
{"item_id": "dbe-fisiese_wetenskappe-g10-v2-2017-nov-6.2.2", "source_id": "dbe-fisiese_wetenskappe-g10-v2-2017-nov", "pair_source_id": "dbe-fisiese_wetenskappe-g10-v2-2017-nov-memo", "subject": "fisiese_wetenskappe", "grade": 12, "language": "af", "track": "sciences", "kind": "question", "question_ref": "6.2.2", "marks": 2, "topic": "Molberekeninge", "passage": "10,6 g natriumkarbonaat reageer.", "question": "Bereken die aanvanklike getal mol natriumkarbonaat.", "memo": "$n = \\frac{m}{M} = \\frac{10,6}{106} \\checkmark = 0,1 \\text{ mol} \\checkmark$", "final_answer": "0,1 mol", "needs_review": false, "licence": "DBE copyright - check terms", "attribution": "Department of Basic Education"}
{"item_id": "dbe-fisiese_wetenskappe-g10-v2-2017-nov-6.2.3", "source_id": "dbe-fisiese_wetenskappe-g10-v2-2017-nov", "pair_source_id": "dbe-fisiese_wetenskappe-g10-v2-2017-nov-memo", "subject": "fisiese_wetenskappe", "grade": 12, "language": "af", "track": "sciences", "kind": "question", "question_ref": "6.2.3", "marks": 4, "topic": "Stoïgiometrie", "passage": "Na2CO3 + 2HCℓ → 2NaCℓ + CO2 + H2O", "question": "Bereken die massa $\\text{CO}_2$ wat gedurende hierdie reaksie gevorm word.", "memo": "$n(\\text{Na}_2\\text{CO}_3) : n(\\text{CO}_2) = 1:1 \\checkmark$. $n(\\text{CO}_2) = 0,1 \\text{ mol} \\checkmark$. $m = n \\times M = 0,1 \\times 44 \\checkmark = 4,4 \\text{ g} \\checkmark$", "final_answer": "4,4 g", "needs_review": false, "licence": "DBE copyright - check terms", "attribution": "Department of Basic Education"}
{"item_id": "dbe-fisiese_wetenskappe-g10-v2-2017-nov-6.2.4", "source_id": "dbe-fisiese_wetenskappe-g10-v2-2017-nov", "pair_source_id": "dbe-fisiese_wetenskappe-g10-v2-2017-nov-memo", "subject": "fisiese_wetenskappe", "grade": 12, "language": "af", "track": "sciences", "kind": "question", "question_ref": "6.2.4", "marks": 6, "topic": "Gaswette en stoïgiometrie", "passage": "4,87 dm³ koolstofdioksied gevorm by STD.", "question": "Bereken die massa natriumchloried wat gevorm word indien 4,87 dm³ koolstofdioksied by STD gevorm is.", "memo": "$n(\\text{CO}_2) = \\frac{V}{V_m} = \\frac{4,87}{22,4} = 0,217 \\text{ mol} \\checkmark$. $n(\\text{NaCℓ}) = 2 \\times n(\\text{CO}_2) = 0,434 \\text{ mol} \\checkmark$. $M(\\text{NaCℓ}) = 58,5 \\text{ g/mol} \\checkmark$. $m = n \\times M = 0,434 \\times 58,5 \\checkmark = 25,39 \\text{ g} \\checkmark$", "final_answer": "25,39 g", "needs_review": false, "licence": "DBE copyright - check terms", "attribution": "Department of Basic Education"}
{"item_id": "dbe-fisiese_wetenskappe-g10-v2-2017-nov-6.3", "source_id": "dbe-fisiese_wetenskappe-g10-v2-2017-nov", "pair_source_id": "dbe-fisiese_wetenskappe-g10-v2-2017-nov-memo", "subject": "fisiese_wetenskappe", "grade": 12, "language": "af", "track": "sciences", "kind": "question", "question_ref": "6.3", "marks": 5, "topic": "Empiriese formules", "passage": "Na2CO3•xH2O → Na2CO3 + xH2O. 14,2 g monster; 5,3 g oorbly.", "question": "Bereken die getal mol kristalwater (x) in die natriumkarbonaatmonster.", "memo": "$m(\\text{H}_2\\text{O}) = 14,2 - 5,3 = 8,9 \\text{ g} \\checkmark$. $n(\\text{H}_2\\text{O}) = 8,9 / 18 = 0,494 \\text{ mol} \\checkmark$. $n(\\text{Na}_2\\text{CO}_3) = 5,3 / 106 = 0,05 \\text{ mol} \\checkmark$. Verhouding $n(\\text{H}_2\\text{O}) : n(\\text{Na}_2\\text{CO}_3) = 0,494 : 0,05 \\approx 10:1 \\checkmark$. Dus $x = 10 \\checkmark$", "final_answer": "10", "needs_review": false, "licence": "DBE copyright - check terms", "attribution": "Department of Basic Education"}
