{"item_id": "dbe-mathematics-g10-p1-2018-nov-1.1.1", "source_id": "dbe-mathematics-g10-p1-2018-nov", "pair_source_id": "dbe-mathematics-g10-p1-2018-nov-memo", "subject": "mathematics", "grade": 12, "language": "en", "track": "core_maths", "kind": "question", "question_ref": "1.1.1", "marks": 2, "topic": "Factorisation - common factor and difference of squares", "passage": "", "question": "Factorise the following expression fully: $4x - x^3$", "memo": "$4x - x^3 = x(4 - x^2) = x(2 - x)(2 + x)$\n* $\\checkmark$ common factor\n* $\\checkmark$ difference of two squares", "final_answer": "$x(2-x)(2+x)$", "needs_review": false, "licence": "DBE copyright - check terms", "attribution": "Department of Basic Education"}
{"item_id": "dbe-mathematics-g10-p1-2018-nov-1.1.2", "source_id": "dbe-mathematics-g10-p1-2018-nov", "pair_source_id": "dbe-mathematics-g10-p1-2018-nov-memo", "subject": "mathematics", "grade": 12, "language": "en", "track": "core_maths", "kind": "question", "question_ref": "1.1.2", "marks": 2, "topic": "Factorisation - trinomial", "passage": "", "question": "Factorise the following expression fully: $x^2 + 15x - 54$", "memo": "$x^2 + 15x - 54 = (x + 18)(x - 3)$\n* $\\checkmark\\checkmark$ factors", "final_answer": "$(x+18)(x-3)$", "needs_review": false, "licence": "DBE copyright - check terms", "attribution": "Department of Basic Education"}
{"item_id": "dbe-mathematics-g10-p1-2018-nov-1.1.3", "source_id": "dbe-mathematics-g10-p1-2018-nov", "pair_source_id": "dbe-mathematics-g10-p1-2018-nov-memo", "subject": "mathematics", "grade": 12, "language": "en", "track": "core_maths", "kind": "question", "question_ref": "1.1.3", "marks": 3, "topic": "Factorisation - grouping", "passage": "", "question": "Factorise the following expression fully: $y - xy + x - 1$", "memo": "$y - xy + x - 1 = y(1 - x) - 1(1 - x) = (y - 1)(1 - x)$\n* $\\checkmark$ grouping\n* $\\checkmark$ change of sign\n* $\\checkmark$ factors", "final_answer": "$(y-1)(1-x)$", "needs_review": false, "licence": "DBE copyright - check terms", "attribution": "Department of Basic Education"}
{"item_id": "dbe-mathematics-g10-p1-2018-nov-1.2.1", "source_id": "dbe-mathematics-g10-p1-2018-nov", "pair_source_id": "dbe-mathematics-g10-p1-2018-nov-memo", "subject": "mathematics", "grade": 12, "language": "en", "track": "core_maths", "kind": "question", "question_ref": "1.2.1", "marks": 2, "topic": "Algebraic simplification - expansion", "passage": "", "question": "Simplify the following expression fully: $(x + 2)(x^2 - x + 3)$", "memo": "$(x + 2)(x^2 - x + 3) = x^3 - x^2 + 3x + 2x^2 - 2x + 6 = x^3 + x^2 + x + 6$\n* $\\checkmark$ simplification\n* $\\checkmark$ answer", "final_answer": "$x^3 + x^2 + x + 6$", "needs_review": false, "licence": "DBE copyright - check terms", "attribution": "Department of Basic Education"}
{"item_id": "dbe-mathematics-g10-p1-2018-nov-2.1.1", "source_id": "dbe-mathematics-g10-p1-2018-nov", "pair_source_id": "dbe-mathematics-g10-p1-2018-nov-memo", "subject": "mathematics", "grade": 12, "language": "en", "track": "core_maths", "kind": "question", "question_ref": "2.1.1", "marks": 2, "topic": "linear equations", "passage": "", "question": "Solve for $x$: $px + qx = a$", "memo": "$x(p+q)=a \\checkmark \\Rightarrow x = \\frac{a}{p+q} \\checkmark$", "final_answer": "$x = \\frac{a}{p+q}$", "needs_review": false, "licence": "DBE copyright - check terms", "attribution": "Department of Basic Education"}
